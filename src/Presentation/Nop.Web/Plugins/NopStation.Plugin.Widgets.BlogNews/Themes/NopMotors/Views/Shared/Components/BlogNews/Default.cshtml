@model PublicModel

@{
    var supportRtl = await Html.ShouldUseRtlThemeAsync();
    if (supportRtl)
    {
        NopHtml.AddCssFileParts("~/Plugins/NopStation.Plugin.Widgets.BlogNews/Themes/NopMotors/Content/css/nopmotors_blognews.rtl.css");
    }
    else
    {
        NopHtml.AddCssFileParts("~/Plugins/NopStation.Plugin.Widgets.BlogNews/Themes/NopMotors/Content/css/nopmotors_blognews.css");
    }
}

@if (Model.BlogPosts.Any() || Model.NewsItems.Any())
{
    var newsGuid = Guid.NewGuid().ToString().Replace('-', '_');
    var blogGuid = Guid.NewGuid().ToString().Replace('-', '_');
    var blogCount = Model.BlogPosts.Count;
    var blogSlidesDesktop = Math.Min(blogCount, 3);
    var blogSlidesTablet = Math.Min(blogCount, 2);
    var newsCount = Model.NewsItems.Count;
    var newsSlidesDesktop = Math.Min(newsCount, 3);
    var newsSlidesTablet = Math.Min(newsCount, 2);


    <div class="custom-container blog-news-container container">
        <div class="blog-news-area">

            @if (Model.NewsItems.Any())
            {
                <div class="latest-news-container">
                    <h2 class="title-container">@T("NopStation.Theme.NopMotors.HomePage.BlogNews.LatestNews")</h2>

                    <div class="single-news">
                        <div class="swiper news-swiper" id="news-swiper-@newsGuid">
                            <div class="swiper-wrapper">
                                @foreach (var item in Model.NewsItems)
                                {
                                    <div class="swiper-slide news-item">
                                        <div class="news-box-inner">
                                            <div class="news-img" style="background-image:url(@item.PictureUrl)">
                                            </div>
                                            <div class="news-details">
                                                <h2 class="text-ellipsis"><a class="post-title" href="@Url.RouteUrl("NewsItem", new { SeName = item.SeName })">@item.Title</a></h2>
                                                <div class="date-time"><i class="icon ns-calendar"></i>@item.CreatedOnUtcStr<span>(@item.TotalComments)</span></div>
                                                <div class="post-body">
                                                    <p>@item.ShortDescription</p>
                                                </div>
                                                <a class="blog-link" href="@Url.RouteUrl("NewsItem", new { SeName = item.SeName })">@T("NopStation.BlogNews.Home.LatestNews.ReadMore") <span class="sr-only">@item.Title</span> <i class="icon ns-arrow-right"></i></a>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                            <div class="swiper-button-next swiper-news-next-@newsGuid"></div>
                            <div class="swiper-button-prev swiper-news-prev-@newsGuid"></div>
                        </div>
                    </div>

                    @* <div class="view-all">
                        <a href="@Url.RouteUrl("NewsArchive")">@T("NopStation.Theme.NopMotors.HomePage.BlogNews.ViewAll")</a>
                    </div> *@
                </div>
            }

            @if (Model.BlogPosts.Any())
            {
                <div class="latest-blog-container">
                    <div class="custom-container-fluid">
                        <h2 class="title-container">@T("NopStation.Theme.NopMotors.HomePage.BlogNews.LatestBlogs")</h2>

                        <div class="swiper blog-swiper" id="blog-swiper-@blogGuid">
                            <div class="swiper-wrapper">
                                @foreach (var item in Model.BlogPosts)
                                {
                                    <div class="swiper-slide blog-item">
                                        <div class="single-blog bg-white">
                                            <div class="blog-img">
                                                <img src="@item.PictureUrl" alt="@item.AltAttribute" width="450" height="450" />
                                            </div>
                                            <div class="blog-details">
                                                <h4 class="text-ellipsis"><a class="post-title" href="@Url.RouteUrl("BlogPost", new { SeName = item.SeName })">@item.Title</a></h4>
                                                <div class="date-time"><i class="icon ns-calendar"></i>  @item.CreatedOnUtcStr<span class="sr-only">(@item.TotalComments)</span></div>
                                                <div class="post-body">
                                                    <p>@item.BodyOverview</p>
                                                </div>
                                                <a class="blog-link" href="@Url.RouteUrl("BlogPost", new { SeName = item.SeName })">@T("NopStation.BlogNews.Home.LatestBlog.ReadMore") <i class="icon ns-arrow-right"></i></a>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                            <div class="swiper-button-next swiper-blog-next-@blogGuid"></div>
                            <div class="swiper-button-prev swiper-blog-prev-@blogGuid"></div>
                        </div>

                        @* <div class="view-all">
                            <a href="@Url.RouteUrl("blog")">@T("NopStation.Theme.NopMotors.HomePage.BlogNews.ViewAll")</a>
                        </div> *@
                    </div>
                </div>
            }

        </div>
    </div>

    <script asp-location="Footer">
        $(document).ready(function () {
            @if (Model.NewsItems.Any())
            {
                    <text>
                    new Swiper("#news-swiper-@newsGuid", {
                        slidesPerView: 'auto',
                        spaceBetween: 15,
                        observer: true,
                        observeParents: true,
                        @* loop: @(newsCount > newsSlidesDesktop ? "true" : "false"), *@
                        loop: false,
                        navigation: {
                            nextEl: ".swiper-news-next-@newsGuid",
                            prevEl: ".swiper-news-prev-@newsGuid",
                        },
                        @* breakpoints: {
                            768:  { slidesPerView: @newsSlidesTablet },
                            1200: { slidesPerView: @newsSlidesDesktop }
                        } *@
                    });

                    const prevNewsButton@(newsGuid) = document.querySelector(".swiper-news-prev-@newsGuid");
                    const nextNewsButton@(newsGuid) = document.querySelector(".swiper-news-next-@newsGuid");

                    if (prevNewsButton@(newsGuid) && nextNewsButton@(newsGuid)) {
                        prevNewsButton@(newsGuid).style.display = "none";

                        let hasMovedForwardNews@(newsGuid) = false;

                        nextNewsButton@(newsGuid).addEventListener("click", () => {
                            if (!hasMovedForwardNews@(newsGuid)) {
                                prevNewsButton@(newsGuid).style.display = "flex";
                                hasMovedForwardNews@(newsGuid) = true;
                            }
                        });
                    }
                    </text>
            }
            @if (Model.BlogPosts.Any())
            {
                    <text>
                    new Swiper("#blog-swiper-@blogGuid", {
                        slidesPerView: 1,
                        spaceBetween: 20,
                        observer: true,
                        observeParents: true,
                        loop: @(blogCount > blogSlidesDesktop ? "true" : "false"),
                        navigation: {
                            nextEl: ".swiper-blog-next-@blogGuid",
                            prevEl: ".swiper-blog-prev-@blogGuid",
                        },
                        breakpoints: {
                            768:  { slidesPerView: @blogSlidesTablet },
                            1200: { slidesPerView: @blogSlidesDesktop }
                        }
                    });
                    </text>
            }
        });
    </script>
}