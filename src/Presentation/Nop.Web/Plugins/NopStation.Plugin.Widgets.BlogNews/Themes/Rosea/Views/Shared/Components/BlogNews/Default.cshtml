@using Nop.Core.Domain.Blogs;
@using Nop.Core.Domain.News;
@model PublicModel
@inject Nop.Core.IWebHelper webHelper
@inject Nop.Core.IWorkContext workContext

@{
    var supportRtl = (await workContext.GetWorkingLanguageAsync()).Rtl;

    if (supportRtl)
    {
        NopHtml.AppendCssFileParts("/Plugins/NopStation.Plugin.Widgets.BlogNews/Themes/Rosea/Content/css/styles.rtl.css");
    }
    else
    {
        NopHtml.AppendCssFileParts("/Plugins/NopStation.Plugin.Widgets.BlogNews/Themes/Rosea/Content/css/styles.css");
    }
}

@if (Model.BlogPosts.Any() || Model.NewsItems.Any())
{
    <div class="blog-news-area">
        @if (Model.BlogPosts.Any())
        {
            <div class="latest-blog-container">
                <div class="custom-container-fluid">
                    <div class="title-container">
                        <div class="title">
                            @T("NopStation.BlogNews.Home.LatestBlog")
                        </div>
                        <div class="subtitle">
                            <a href="@Url.RouteUrl(NopRouteNames.General.BLOG)">@T("NopStation.BlogNews.Home.ViewAll.Posts")</a>
                        </div>
                    </div>
                    <div class="row blog-items">
                        @foreach (var item in Model.BlogPosts)
                        {
                            <div class="blog-item">
                                <div class="single-blog">
                                    <a href="@(await NopUrl.RouteGenericUrlAsync<BlogPost>(new { SeName = item.SeName }))">
                                        <img src="@item.PictureUrl" alt="@item.AltAttribute" />
                                    </a>
                                    <div class="title-block">
                                        <div class="date-time"><span>@item.CreatedOnUtcStr</span></div>
                                        <a class="post-title" href="@(await NopUrl.RouteGenericUrlAsync<BlogPost>(new { SeName = item.SeName }))">@item.Title</a>
                                    </div>
                                    <div class="post-body">
                                        @Html.Raw(item.BodyOverview)
                                    </div>
                                    <a class="blog-link" href="@(await NopUrl.RouteGenericUrlAsync<BlogPost>(new { SeName = item.SeName }))">@T("NopStation.BlogNews.Home.LatestBlog.ReadMore")</a>
                                    <ul class="blog-news-social">
                                        <li> <a href="https://www.facebook.com/sharer/sharer.php?u=@webHelper.GetThisPageUrl(true)&t=@item.Title"> <i class="fa fa-facebook" aria-hidden="true"></i> </a> </li>
                                        <li> <a href="https://twitter.com/share?url=@webHelper.GetThisPageUrl(true)&via=TWITTER_HANDLE&text=@item.Title"> <i class="fa fa-twitter" aria-hidden="true"></i> </a> </li>
                                        <li> <a href="https://plus.google.com/share?url=@webHelper.GetThisPageUrl(true)"> <i class="fa fa-google-plus" aria-hidden="true"></i> </a> </li>
                                    </ul>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        @if (Model.NewsItems.Any())
        {
            <div class="latest-news-container">
                <div class="title-container">
                    <div class="title">
                        @T("NopStation.BlogNews.Home.LatestNews")
                    </div>
                    <div class="subtitle">
                        <a href="@Url.RouteUrl(NopRouteNames.General.NEWS)">@T("NopStation.BlogNews.Home.ViewAll.News")</a>
                    </div>
                </div>
                <div class="single-news">
                    <div class="row news-items">
                        @foreach (var item in Model.NewsItems)
                        {
                            <div class="news-item">
                                <div class="news-box-inner">
                                    <div class="picture">
                                        <img src="@item.PictureUrl" alt="@item.AltAttribute" />
                                    </div>
                                    <div class="news-box-info">
                                        <div class="date-time"><span>@item.CreatedOnUtcStr</span></div>
                                        <h4 class="text-ellipsis">
                                            <a class="post-title" href="@(await NopUrl.RouteGenericUrlAsync<NewsItem>(new { SeName = item.SeName }))">@item.Title</a>
                                        </h4>
                                        <div class="post-body">
                                            <p>@item.ShortDescription</p>
                                        </div>
                                        <a class="news-link" href="@(await NopUrl.RouteGenericUrlAsync<NewsItem>(new { SeName = item.SeName }))">@T("NopStation.BlogNews.Home.LatestNews.ReadMore")</a>
                                        <ul class="blog-news-social pl-0">
                                            <li> <a href="https://www.facebook.com/sharer/sharer.php?u=@webHelper.GetThisPageUrl(true)&t=@item.Title"> <i class="fa fa-facebook" aria-hidden="true"></i> </a> </li>
                                            <li> <a href="https://twitter.com/share?url=@webHelper.GetThisPageUrl(true)&via=TWITTER_HANDLE&text=@item.Title"> <i class="fa fa-twitter" aria-hidden="true"></i> </a> </li>
                                            <li> <a href="https://plus.google.com/share?url=@webHelper.GetThisPageUrl(true)"> <i class="fa fa-google-plus" aria-hidden="true"></i> </a> </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}