@model OfferZoneModel
@inject Nop.Core.IWorkContext workContext

@{
    var supportRtl = (await workContext.GetWorkingLanguageAsync()).Rtl;

    if (supportRtl)
    {
        NopHtml.AppendCssFileParts("/Plugins/NopStation.Plugin.Theme.Rosea/Content/css/offer-zone.rtl.css");
    }
    else
    {
        NopHtml.AppendCssFileParts("/Plugins/NopStation.Plugin.Theme.Rosea/Content/css/offer-zone.css");
    }
}

<div class="category-middle">
    <div class="item-grid">
        <div class="category-item">
            <a href="@(!string.IsNullOrWhiteSpace(Model.RedirectUrl1)? Model.RedirectUrl1 : "#")">
                <img alt="img" src="@Model.PictureUrl1" title="" />
            </a>
        </div>
        <div class="category-item">
            <a href="@(!string.IsNullOrWhiteSpace(Model.RedirectUrl2)? Model.RedirectUrl2 : "#")">
                <img alt="img" src="@Model.PictureUrl2" title="" />
            </a>
        </div>
        <div class="category-item">
            <a href="@(!string.IsNullOrWhiteSpace(Model.RedirectUrl3)? Model.RedirectUrl3 : "#")">
                <img alt="img" src="@Model.PictureUrl3" title="" />
            </a>
        </div>
        <div class="category-item">
            <a href="@(!string.IsNullOrWhiteSpace(Model.RedirectUrl4)? Model.RedirectUrl4 : "#")">
                <img alt="img" src="@Model.PictureUrl4" title="" />
            </a>
        </div>
    </div>
</div>