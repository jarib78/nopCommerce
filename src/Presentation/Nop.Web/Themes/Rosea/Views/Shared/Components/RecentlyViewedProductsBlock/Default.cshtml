@using Nop.Core.Domain.Catalog;
@model IList<ProductOverviewModel>
@if (Model.Count > 0)
{
    <div class="block block-recently-viewed-products">
        <div class="title">@T("Products.RecentlyViewedProducts")
        </div>
        <div class="listbox">
            <ul class="list">
                @for (var i = 0; i < Model.Count; i++)
                {
                    var product = Model[i];
                    <li @(i == Model.Count - 1 ? @Html.Raw(" class=\"last\"") : null)>
                        <div class="picture">

                            @if (product.PictureModels.Count > 1)
                            {
                                <div class="swiper" id="swiper-@product.Id" dir="@Html.GetUIDirection(!await Html.ShouldUseRtlThemeAsync())">
                                    <div class="swiper-wrapper">
                                        @foreach (var picture in product.PictureModels)
                                        {
                                            <a class="swiper-slide product-picture" href="@(await NopUrl.RouteGenericUrlAsync<Product>(new { SeName = product.SeName }))" title="@picture.Title">
                                                <img alt="@picture.AlternateText" src="@picture.ImageUrl" title="@picture.Title" />
                                                @await Component.InvokeAsync("Widget", new { widgetZone = "MultipleProductBoxImageZone", additionalData = product.Id })
                                            </a>
                                        }
                                    </div>
                                    <!-- Add Pagination -->
                                    <div class="swiper-pagination"></div>
                                </div>

                                <script asp-location="Footer">
                                    new Swiper('#swiper-@(product.Id)', {
                                        pagination: {
                                            clickable: true,
                                            el: '.swiper-pagination',
                                        },
                                    });
                                </script>
                            }
                            else
                            {
                                var picture = product.PictureModels.FirstOrDefault();
                                <a class="product-picture" href="@(await NopUrl.RouteGenericUrlAsync<Product>(new { SeName = product.SeName }))" title="@picture?.Title">
                                    <img alt="@picture?.AlternateText" src="@picture?.ImageUrl" title="@picture?.Title" />
                                    @await Component.InvokeAsync("Widget", new { widgetZone = "MultipleProductBoxImageZone", additionalData = product.Id })
                                </a>
                            }
                        </div>
                        <a class="product-name" href="@(await NopUrl.RouteGenericUrlAsync<Product>(new { SeName = product.SeName }))">@product.Name</a>
                    </li>
                }
            </ul>
        </div>
    </div>
}