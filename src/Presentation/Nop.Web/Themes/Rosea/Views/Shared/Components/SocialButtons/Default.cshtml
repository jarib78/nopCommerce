@model SocialModel
<ul class="networks">
	@if (!string.IsNullOrEmpty(Model.FacebookLink))
	{
		<li class="facebook"><a href="@Model.FacebookLink" target="_blank" title=" @T("Footer.FollowUs.Facebook")">
   <i class="fa fa-facebook-official" aria-hidden="true"></i>
    </a></li>
	}
	@if (!string.IsNullOrEmpty(Model.TwitterLink))
	{
		<li class="twitter"><a href="@Model.TwitterLink" title="@T("Footer.FollowUs.Twitter")" target="_blank">
    <i class="fa fa-twitter-square" aria-hidden="true"></i>
    </a></li>
	}
	@if (Model.NewsEnabled)
	{
		<li class="rss"><a href="@Url.RouteUrl(NopRouteNames.Standard.NEWS_RSS, new {languageId = Model.WorkingLanguageId})" title=" @T("Footer.FollowUs.RSS")">
    <i class="fa fa-rss-square" aria-hidden="true"></i>
   
</a></li>
	}
	@if (!string.IsNullOrEmpty(Model.YoutubeLink))
	{
		<li class="youtube"><a href="@Model.YoutubeLink" title=" @T("Footer.FollowUs.Youtube")" target="_blank">
   <i class="fa fa-youtube-play" aria-hidden="true"></i>
    </a></li>
	}
</ul>