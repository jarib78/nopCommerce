@model IList<ProductOverviewModel>
@using Nop.Core.Infrastructure
@using Nop.Core
@{

    var rtl = (await EngineContext.Current.Resolve<IWorkContext>().GetWorkingLanguageAsync()).Rtl;
}
@if (Model.Count > 0)
{
    <div class="also-purchased-products-grid product-grid related-product">
        <div class="title">
            <strong>@T("Products.AlsoPurchased")</strong>
        </div>
        <div class="item-grid owl-carousel ocarousel" id="also-purchased-products">
            @foreach (var item in Model)
            {
                <div class="item-box">@await Html.PartialAsync("_ProductBox", item)</div>
            }
        </div>
    </div>
}
