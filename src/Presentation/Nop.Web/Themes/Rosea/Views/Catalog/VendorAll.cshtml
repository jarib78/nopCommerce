@using Nop.Core.Domain.Vendors;
@model IList<VendorModel>
@{
    Layout = "_ColumnsTwo";

    //title
    NopHtml.AddTitleParts(T("PageTitle.Vendors").Text);
    //page class
    NopHtml.AppendPageCssClassParts("html-vendor-list-page");
}
@section Breadcrumb
    {
        <div class="page-title">
            <div class="breadcrumb">
                <div class="section-container">
                    <h1> @T("Vendors.List") </h1>
                </div>
                <ul itemscope itemtype="http://schema.org/BreadcrumbList">
                    <li>
                        <a href="@Url.RouteUrl(NopRouteNames.General.HOMEPAGE)" title="@T("Categories.Breadcrumb.Top")">@T("Categories.Breadcrumb.Top")</a>
                        <span class="delimiter">/</span>
                    </li>
                <li>
                    <strong class="current-item" itemprop="name">  @T("Vendors.List") </strong>
                </li>
                </ul>
            </div>
        </div>
        @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.CategoryDetailsAfterBreadcrumb, additionalData = Model })
}
<div class="page vendor-list-page">
    <div class="page-body">
        <div class="product-grid">
            <div class="item-grid">
                @foreach (var item in Model)
                {
                    <div class="single-item">
                        <div class="item-box">
                            <div class="vendor-item">
                                <h2 class="title">
                                    <a href="@(await NopUrl.RouteGenericUrlAsync<Vendor>(new { SeName = item.SeName }))" title="@item.PictureModel.Title">
                                        @item.Name
                                    </a>
                                </h2>
                                <div class="picture">
                                    <a href="@(await NopUrl.RouteGenericUrlAsync<Vendor>(new { SeName = item.SeName }))" title="@item.PictureModel.Title">
                                        <img alt="@item.PictureModel.AlternateText" src="@item.PictureModel.ImageUrl" title="@item.PictureModel.Title" />
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                }
            </div>
        </div>
    </div>
</div>